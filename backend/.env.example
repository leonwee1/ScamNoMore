# Copy this file to .env and fill in your values.
#   Windows PowerShell:  copy .env.example .env
#   macOS / Linux:       cp .env.example .env
#
# .env is gitignored — never commit real secrets.

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Shared secret the app must send as the x-app-secret header.
# Leave EMPTY for local development (no auth). REQUIRED before deploying
# publicly, otherwise anyone who finds your URL can spend your OpenAI quota.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
APP_SHARED_SECRET=

# Optional overrides
# OPENAI_CHAT_MODEL=gpt-4o           # must be vision-capable for image analysis
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# PORT=3000

# SQLite store for submitted reports and community messages. Leave this unset
# locally to use backend/data/scamnomore.sqlite. On Render, set it to a file
# below the persistent disk mount, for example /var/data/scamnomore.sqlite.
# REPORTS_DB_PATH=/var/data/scamnomore.sqlite

# Rate limits. The global limits are the non-bypassable cap for a public demo;
# set them to a number that fits your OpenAI budget and expected judges/tests.
# RATE_LIMIT_BURST_MAX=15            # requests per minute
# RATE_LIMIT_BURST_WINDOW_MS=60000
# RATE_LIMIT_DAILY_MAX=200           # requests per day
# RATE_LIMIT_GLOBAL_BURST_MAX=60     # all requests per minute
# RATE_LIMIT_GLOBAL_DAILY_MAX=250    # all requests per day
