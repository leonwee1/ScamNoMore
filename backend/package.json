{
  "name": "scamnomore-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ScamNoMore backend — OpenAI (gpt-4o vision, Whisper) scam analysis + chatbot",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node src/local-server.ts",
    "build": "tsc",
    "start": "node dist/local-server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ffmpeg-static": "5.2.0",
    "openai": "^4.67.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
